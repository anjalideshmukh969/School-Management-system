PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/school_management
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Optional — configure these to actually email password-reset links.
# Without them, forgot-password still works: the reset link is returned
# directly in the API response (shown on the Forgot Password page) instead
# of being emailed. Any standard SMTP provider works (Gmail app password,
# SendGrid, Mailgun, your institution's mail server, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
